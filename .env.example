# --- App ---
APP_NAME=paperai
ENV=local
LOG_LEVEL=INFO
# Origins được phép gọi API trực tiếp (không qua Vite proxy), phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (host ports: xem docker-compose.yml; trong container dùng postgres:5432) ---
DATABASE_URL=postgresql+psycopg://paperai:paperai@localhost:5433/paperai

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=paper_chunks

# --- Celery / Redis ---
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# --- LLM providers (điền ít nhất 1 key) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ép research agent dùng 1 provider cụ thể: openrouter | groq | gemini | anthropic | openai
# Để trống = tự chọn theo thứ tự openrouter -> groq -> gemini -> anthropic -> openai (key nào có).
AGENT_PROVIDER=

# --- Embedding / rerank ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# auto | cpu | cuda | cuda:0 | mps — auto: ưu tiên GPU nếu còn đủ VRAM trống, không thì CPU
EMBEDDING_DEVICE=auto
# TTL cache embedding trong Redis (giây); 0 = không hết hạn
EMBEDDING_CACHE_TTL_SECONDS=2592000

# --- Retrieval ---
HYBRID_ALPHA=0.7
HYBRID_BETA=0.3
CONTEXT_TOKEN_LIMIT=8000

# --- Upload ---
MAX_UPLOAD_MB=50
UPLOAD_DIR=data/papers

# --- External sources ---
OPEN_ALEX_API_URL=https://api.openalex.org
OPEN_ALEX_API_KEY=

# --- PDF export ---
# Render sơ đồ Mermaid qua dịch vụ công cộng mermaid.ink (gửi nội dung sơ đồ ra ngoài).
# Tắt (false) nếu báo cáo nhạy cảm; khi đó sơ đồ được in dưới dạng code block.
MERMAID_INK_ENABLED=true
