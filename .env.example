# ==========================================
# PaperAI Configuration (.env)
# ==========================================

APP_NAME=paperai
ENV=local
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# Dùng cấu hình này nếu chạy API / Worker bên trong Docker:
# DATABASE_URL=postgresql+psycopg://paperai:paperai@postgres:5432/paperai
# Dùng cấu hình này nếu chạy API / Worker trực tiếp trên máy host (DB trong Docker):
# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://paperai:paperai@postgres:5432/paperai

# --- Vector Store (Qdrant) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=paper_chunks

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- LLM Providers ---
# GEMINI_API_KEY (Gemini 2.5 Flash / 1.5 Pro)
GEMINI_API_KEY=
# OPENROUTER_API_KEY (OpenRouter.ai - Free Models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# GROQ_API_KEY (Groq Cloud)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# --- Embedding & Rerank ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- RAG Retrieval Params ---
HYBRID_ALPHA=0.7
HYBRID_BETA=0.3
CONTEXT_TOKEN_LIMIT=8000

# --- External Sources (OpenAlex) ---
OPEN_ALEX_API_URL=https://api.openalex.org
OPEN_ALEX_API_KEY=

# --- OpenRouter: Gemma free (dùng làm model dự phòng) ---
OPENROUTER_GEMMA_31B_MODEL=google/gemma-4-31b-it:free
OPENROUTER_GEMMA_26B_MODEL=google/gemma-4-26b-a4b:free

# --- HuggingFace (tuỳ chọn): token giúp tải model nhanh hơn, bỏ cảnh báo 'unauthenticated requests' ---
# HF_TOKEN=
